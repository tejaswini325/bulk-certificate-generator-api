# Copy values into your shell environment (the app reads os.environ; it does not load .env files).
DATABASE_URL=sqlite:///./certificates.db
STORAGE_DIR=./storage
MAX_RECIPIENTS_PER_JOB=500
MAX_NAME_LENGTH=100
MAX_REQUEST_BYTES=1048576
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_BATCH_SIZE=50
STALE_JOB_SECONDS=60
MAX_JOB_ATTEMPTS=3
LOG_LEVEL=INFO
